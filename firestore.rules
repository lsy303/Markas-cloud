rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المشرف: يوجد له مستند في admins/{uid} (يُنشأ يدوياً من Firebase Console)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // الترخيص فعّال + غير منتهي (expiresAt اختياري)
    function licensed(uid) {
      let lic = get(/databases/$(database)/documents/licenses/$(uid)).data;
      return lic.active == true
        && (!('expiresAt' in lic) || lic.expiresAt > request.time);
    }

    // المشرفون: يقرأ المشرف مستنده فقط — الإنشاء من Firebase Console فقط
    match /admins/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // التراخيص: المركز يقرأ ترخيصه فقط — المشرف يقرأ ويعدّل الجميع من لوحة الإدارة
    match /licenses/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // بيانات المركز وكل الجداول الفرعية
    // الحساب التجريبي (demo == true): قراءة فقط — بياناته لا تتغير مهما عدّل الزوار
    match /centers/{centerId}/{document=**} {
      allow read: if request.auth != null
        && request.auth.uid == centerId
        && licensed(centerId);
      allow write: if request.auth != null
        && request.auth.uid == centerId
        && licensed(centerId)
        && get(/databases/$(database)/documents/licenses/$(centerId)).data.get('demo', false) != true;
    }
  }
}
